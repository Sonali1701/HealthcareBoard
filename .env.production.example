# ============================================================
#  PRODUCTION CONFIG TEMPLATE
#  Copy to ".env" on the server and fill the 2 credential blocks
#  marked  <<< FILL >>>  . Everything else is already wired.
# ============================================================

ENVIRONMENT=production
DEBUG=false

# ------------------------------------------------------------
# 1) DATABASE — PostgreSQL                       <<< FILL >>>
# ------------------------------------------------------------
# Render: copy the "Internal Database URL" from your Render Postgres,
# and change the scheme to postgresql+psycopg://
#   e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# ------------------------------------------------------------
# 2) OBJECT STORAGE — Cloudflare R2 (résumés/photos)  <<< FILL >>>
# ------------------------------------------------------------
STORAGE_ENABLED=true
# R2 endpoint:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=healthboard
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# Public URL base for objects (R2 public bucket "r2.dev" URL or a custom domain):
S3_PUBLIC_BASE_URL=https://<your-public-r2-domain>
# Leave S3_ACL EMPTY for R2 (R2 rejects ACLs). Set "public-read" only for AWS S3.
S3_ACL=

# ------------------------------------------------------------
#  Auth — REQUIRED: generate a fresh secret
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------
JWT_SECRET=<PASTE_A_FRESH_RANDOM_SECRET>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------
#  CORS — lock to your real frontend origin(s)
# ------------------------------------------------------------
CORS_ORIGINS=https://your-app-domain.com
FRONTEND_BASE_URL=https://your-app-domain.com

# ------------------------------------------------------------
#  Email — SendGrid (optional but recommended for real users)
# ------------------------------------------------------------
EMAIL_ENABLED=true
SENDGRID_API_KEY=<SENDGRID_API_KEY>
EMAIL_FROM=no-reply@your-app-domain.com
EMAIL_FROM_NAME=HealthBoard

# ------------------------------------------------------------
#  First admin (created automatically on startup)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@your-app-domain.com
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>

# ------------------------------------------------------------
#  GSA per-diem (optional; empty => FY2025 fallback rates)
# ------------------------------------------------------------
GSA_API_KEY=
GSA_FISCAL_YEAR=2025

# ------------------------------------------------------------
#  Ceipal ATS — fetch jobs into the board (optional)
#  Auth POSTs {email, password, apiKey}; report is paged via &page=N.
#  Sync:  python -m app.importers.ceipal_jobs   (or POST /api/integrations/ceipal/sync)
# ------------------------------------------------------------
CEIPAL_ENABLED=true
CEIPAL_EMAIL=<CEIPAL_LOGIN_EMAIL>
CEIPAL_PASSWORD=<CEIPAL_PASSWORD>
CEIPAL_API_KEY=<CEIPAL_API_KEY>
# The Custom Report "get-report-data" URL for your JOBS report:
CEIPAL_REPORT_URL=https://atsbi.ceipal.com/api/report-details/get-report-data/<REPORT_ID>?response_type=1
