# Current local database. DATABASE_URL is ignored while this is sqlite.
DATABASE_BACKEND=sqlite
DATABASE_URL=
DATABASE_NAME=

# Optional local SQLite fallback when DATABASE_URL is not set.
SOURCING_DB=sourcing.db
RESUME_DOWNLOAD_DIR=C:\Users\your-user\Downloads
RESUME_MAX_BYTES=15728640

# Enformion / Endato enrichment.
ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=
ENFORMION_DEMO=1

# Optional Gemini identity second opinion and outreach generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MATCH_ENABLED=0
IDENTITY_MATCH_THRESHOLD=0.72

# Optional server-side contact verification (may use provider credits).
VERIFY_EMAILS=0
NEVERBOUNCE_API_KEY=
VERIFY_PHONES=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
DEFAULT_PHONE_COUNTRY=US

# Optional private Cloudflare R2 storage for matched candidate resumes.
STORAGE_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
